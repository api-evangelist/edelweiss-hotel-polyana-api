{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-06-18/server.schema.json",
  "name": "io.github.kyivuinua/edelweiss-hotel-mcp",
  "version": "1.0.0",
  "description": "Official Model Context Protocol (MCP) server for Edelweiss Hotel Polyana (Carpathians, Ukraine). Enables AI assistants to query live tariffs, medical profiles for Polyana Kvasova mineral water, and compute real-time stay quotes.",
  "title": "Edelweiss Hotel MCP",
  "websiteUrl": "https://edelweiss-hotel.com.ua/api-docs",
  "repository": {
    "url": "https://github.com/kyivuinua/wordpress-edelweiss",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://edelweiss-hotel.com.ua/.well-known/mcp-server.json"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/custom": {
      "capabilities": {
        "tools": true,
        "resources": true
      },
      "tools": [
        {
          "name": "get_hotel_tariffs",
          "description": "Fetch official 2026 master tariffs, verified Booking.com rating (9.2/10), amenities, infrastructure, and policies for Edelweiss Hotel Polyana.",
          "parameters": {
            "type": "object",
            "properties": {}
          },
          "endpoint": {
            "url": "https://edelweiss-hotel.com.ua/wp-json/edelweiss/v1/ai-info/",
            "method": "GET"
          }
        },
        {
          "name": "calculate_stay_quote",
          "description": "Calculate accurate total price for stay with itemized cost breakdown (accommodation, meals, resort tax, military discount) and direct booking link.",
          "parameters": {
            "type": "object",
            "properties": {
              "check_in": {
                "type": "string",
                "description": "Check-in date in YYYY-MM-DD format (e.g. '2026-10-01')"
              },
              "check_out": {
                "type": "string",
                "description": "Check-out date in YYYY-MM-DD format (e.g. '2026-10-05')"
              },
              "room": {
                "type": "string",
                "enum": [
                  "standard",
                  "standart",
                  "superior-triple",
                  "pokrashchenyy-trymisnyy",
                  "classic-lux",
                  "klasychnyy-lyuks",
                  "lux"
                ],
                "description": "Room category key or slug ('standard', 'superior-triple', 'classic-lux', 'lux')"
              },
              "guests": {
                "type": "integer",
                "description": "Number of guests (default 2)"
              },
              "meals": {
                "type": "boolean",
                "description": "Include full-board 3-times daily dining (600 UAH/day/person)"
              },
              "military": {
                "type": "boolean",
                "description": "Apply 10% discount for AFU/ZSU servicemen and combat veterans"
              }
            },
            "required": [
              "check_in",
              "check_out"
            ]
          },
          "endpoint": {
            "url": "https://edelweiss-hotel.com.ua/wp-json/edelweiss/v1/quote/",
            "method": "GET"
          }
        },
        {
          "name": "get_google_hotels_feed",
          "description": "Retrieve real-time Google Hotel Center XML inventory and pricing feed.",
          "parameters": {
            "type": "object",
            "properties": {}
          },
          "endpoint": {
            "url": "https://edelweiss-hotel.com.ua/wp-json/edelweiss/v1/google-hotels/",
            "method": "GET"
          }
        },
        {
          "name": "search_faqs",
          "description": "Search FAQs from Edelweiss Hotel using semantic relevance scoring. Returns top matches in the requested language with Ukrainian/English content.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "Search query in Ukrainian or English (e.g. 'СПА', 'parking', 'check-in time')"
              },
              "lang": {
                "type": "string",
                "description": "Response language: 'uk' for Ukrainian, 'en' for English",
                "enum": [
                  "uk",
                  "en"
                ],
                "default": "uk"
              },
              "top_k": {
                "type": "integer",
                "description": "Number of results to return (max 20)",
                "default": 5,
                "maximum": 20
              }
            },
            "required": [
              "query"
            ]
          },
          "endpoint": {
            "url": "https://edelweiss-hotel.com.ua/wp-json/edelweiss/v1/faq-search/",
            "method": "GET"
          }
        }
      ],
      "resources": [
        {
          "uri": "https://edelweiss-hotel.com.ua/llms.txt",
          "name": "LLM Standard Manifest (Ukrainian)",
          "mimeType": "text/markdown"
        },
        {
          "uri": "https://edelweiss-hotel.com.ua/llms-en.txt",
          "name": "LLM Standard Manifest (English)",
          "mimeType": "text/markdown"
        },
        {
          "uri": "https://edelweiss-hotel.com.ua/llms-full.txt",
          "name": "LLM Full Knowledge Base (Ukrainian)",
          "mimeType": "text/markdown"
        },
        {
          "uri": "https://edelweiss-hotel.com.ua/llms-full-en.txt",
          "name": "LLM Full Knowledge Base (English)",
          "mimeType": "text/markdown"
        },
        {
          "uri": "https://edelweiss-hotel.com.ua/openapi.json",
          "name": "OpenAPI 3.1.0 Specification",
          "mimeType": "application/json"
        },
        {
          "uri": "https://edelweiss-hotel.com.ua/wp-json/edelweiss/v1/faq-search",
          "name": "Edelweiss FAQ Knowledge Base",
          "description": "Searchable FAQ knowledge base with 500+ questions in Ukrainian and English about hotel services, rooms, spa, dining, booking, and more.",
          "mimeType": "application/json"
        }
      ]
    }
  }
}
